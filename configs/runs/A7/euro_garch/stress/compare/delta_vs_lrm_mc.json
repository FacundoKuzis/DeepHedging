        "benchmark_lrm_mc_parallel_enabled": true,
        "benchmark_lrm_mc_n_workers": 8,
        "benchmark_lrm_mc_parallel_backend": "thread",
        "benchmark_lrm_mc_parallel_chunk_size": 4096,
        "benchmark_lrm_verbose": true,
        "benchmark_lrm_log_every_t": 10,
        "benchmark_lrm_mc_log_every_chunks": 200

{
  "extends": "./base.json",
  "run_name": "a7_euro_garch_stress_delta_vs_lrm_mc_cmp",
  "description": "A7 stress GARCH: Delta-BS vs LRM with Monte Carlo continuation.",
  "benchmark_agents_to_compare": [

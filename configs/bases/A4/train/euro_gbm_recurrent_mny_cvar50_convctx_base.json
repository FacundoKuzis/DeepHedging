{
  "extends": "../../../bases/A3/train/euro_gbm_wavenet_mny_cvar50_base.json",
  "description": "A4 base train: Recurrent log-moneyness, CVaR50, no costs, seen context with Conv1D encoder.",
  "agent_name": "RecurrentAgent",
  "use_price_history_context": true,
  "context_for_path_generation_only": false,
  "context_length": 42,
  "context_feature_mode": "log_moneyness",
  "history_conv1d_enabled": true,
  "history_conv1d_pooling": "global_max",
  "history_conv1d_layers": [
    {
      "filters": 16,
      "kernel_size": 3,
      "dilation_rate": 1,
      "activation": "relu",
      "dropout": 0.0,
      "use_batch_norm": false,
      "use_residual": false
    },
    {
      "filters": 16,
      "kernel_size": 3,
      "dilation_rate": 2,
      "activation": "relu",
      "dropout": 0.05,
      "use_batch_norm": false,
      "use_residual": true
    }
  ]
}
